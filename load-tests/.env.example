# Copy to load-tests/.env and fill in the values from your own deployment.
# load-tests/.env is gitignored.

# API Gateway stage URL, e.g. https://<api-id>.execute-api.<region>.amazonaws.com/Prod
BASE_URL=

# Cognito app client ID and the password of the test tenant admin users
COGNITO_CLIENT_ID=
TEST_USER_PASSWORD=

# Space-separated API Gateway usage plan IDs whose daily quota is reset before a run
USAGE_PLAN_IDS=""

